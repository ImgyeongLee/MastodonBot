# ==================================================================
# 이 파일을 복사해서 파일명을 .env 로 바꾼 뒤, 아래 값들을 채워주세요.
# (터미널에서: cp .env.sample .env)
# ==================================================================

# ------------------------------------------------------------------
# 1. 마스토돈 봇 접속 정보
# ------------------------------------------------------------------
CLIENT_ID=클라이언트 키를 복사 붙여넣기 하세요.
CLIENT_SECRET=클라이언트 비밀 키를 복사 붙여넣기 하세요.
ACCESS_TOKEN=액세스 토큰을 복사 붙여넣기 하세요.
API_BASE_URL=https://planet.moe (혹은 여러분이 사용하시는 인스턴스 기본 주소)

# ------------------------------------------------------------------
# 2. 구글 스프레드시트 접속 정보
# ------------------------------------------------------------------
CRENDENTIAL_JSON=당신의credential.json
GOOGLE_SHEET_URL=당신의 구글 스프레드 시트 공유 URL

# ------------------------------------------------------------------
# 3. 기능 켜기 / 끄기
# ------------------------------------------------------------------
# true 로 하면 기능이 켜지고, false 로 하면 꺼집니다.
# 기능을 꺼두면 아래에서 설정한 키워드로 멘션해도 봇이 반응하지 않습니다.
ENABLE_INVESTIGATE=true
ENABLE_GATCHA_PROB=true
ENABLE_GATCHA_SIMPLE=true
ENABLE_GATCHA_DESC=true
ENABLE_SHOP=true
ENABLE_ATTENDANCE=true
ENABLE_DICE=true
ENABLE_TRUEFALSE=true

# ------------------------------------------------------------------
# 4. 명령어(키워드) 바꾸기
# ------------------------------------------------------------------
# 사용자가 [키워드] 형식으로 멘션하는 단어를 원하는 대로 바꿀 수 있습니다.
# 예) KEYWORD_ATTENDANCE=출석확인
#     -> 이제 [출석] 이 아니라 [출석확인] 이라고 멘션해야 출석 체크가 됩니다.
#
# 주의 1: 서로 다른 기능끼리 같은 키워드를 쓰면 안 됩니다.
#        (예: 조사와 구매가 둘 다 "확인" 이면 안 됨)
# 주의 2: GATCHA_PROB 와 GATCHA_DESC 의 기본값이 둘 다 "가챠" 인 것은 정상입니다.
#        [가챠/5] 처럼 숫자와 함께 부르면 GATCHA_PROB, [가챠] 만 부르면
#        GATCHA_DESC 가 실행되어 서로 구분되기 때문입니다. 둘 다 바꾸고 싶다면
#        다른 단어로 바꿔도 되고, 같은 단어를 유지해도 됩니다.
KEYWORD_INVESTIGATE=조사
# 사용법: [조사/키워드]

KEYWORD_GATCHA_PROB=가챠
# 사용법: [가챠/n]  (희귀도가 있는 확률 가챠를 n회 연속으로 뽑기, 최대 GATCHA_MAX_PULLS 회)

KEYWORD_GATCHA_SIMPLE=뽑기
# 사용법: [뽑기/n]  (희귀도 구분 없이 아이템만 n개 뽑기, 최대 GATCHA_MAX_PULLS 회)

KEYWORD_GATCHA_DESC=가챠
# 사용법: [가챠]  (설명이 있는 가챠를 1회만 뽑기)

KEYWORD_SHOP=구매
# 사용법: [구매/아이템이름]

KEYWORD_ATTENDANCE=출석
# 사용법: [출석]

KEYWORD_TRUEFALSE=T/F
# 사용법: [T/F]

KEYWORD_DICE=d
# 사용법: [주사위개수 + 이 글자 + 주사위면수], 예) [2d6] (대소문자 구분 없음)

# ------------------------------------------------------------------
# 5. 기타 세부 설정
# ------------------------------------------------------------------
# 가챠를 한 번에 최대 몇 번까지 연속으로 뽑을 수 있는지
GATCHA_MAX_PULLS=10
